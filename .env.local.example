# ============================================================
# Family OS — Firebase Configuration
# ============================================================
# 1. Go to Firebase Console → Project Settings → General
# 2. Under "Your apps", click your Web app (or create one)
# 3. Copy the firebaseConfig values below

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ============================================================
# Firebase Cloud Messaging (Push Notifications)
# ============================================================
# Go to Firebase Console → Project Settings → Cloud Messaging
# Under "Web Push certificates", click "Generate key pair"
# Copy the Key Pair value below

NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# ============================================================
# Firebase Admin SDK (for server-side notification sending)
# ============================================================
# Go to Firebase Console → Project Settings → Service accounts
# Click "Generate new private key" and download the JSON
# Copy values from that JSON file below

FIREBASE_ADMIN_PROJECT_ID=your_project_id_here
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# Google Gemini API — for AI Voice Parser (gemini-2.5-flash)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

